@implements IDisposable
@inject CartState Cart
@inject AddToCartFlow Flow
@inject ModalService Modal
@inject IJSRuntime JS
@inject NavigationManager Nav

<header class="topbar">
    <div class="container-xl topbar-inner">
        <a class="brand" href="/" aria-label="AMS Supplies home">
            <span class="brand-pill">
                <img src="images/one-ncr-stronger-together.png" alt="DepEd NCR, One NCR Stronger Together" width="119" height="38" />
            </span>
            <span class="brand-text">
                <strong>AMS Supplies</strong>
                <small>Asset Management Section</small>
            </span>
        </a>

        <PhClock Class="d-none d-xxl-inline-flex topbar-clock" />

        <nav class="topbar-actions" aria-label="Account">
            <NavLink class="topbar-link topbar-icon" href="help" title="Help and FAQ">
                <i class="bi bi-question-circle" aria-hidden="true"></i>
                <span class="visually-hidden">Help</span>
                @if (_isNew) { <span class="new-dot d-md-none"><span class="visually-hidden">New updates</span></span> }
            </NavLink>
            <NavLink class="topbar-link topbar-icon d-none d-md-flex" href="whats-new" title="@(_isNew ? "What's new: there are updates you haven't seen" : "What's new")">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <span class="visually-hidden">What's new</span>
                @if (_isNew) { <span class="new-dot"><span class="visually-hidden">New updates</span></span> }
            </NavLink>
            <ThemeToggle Class="topbar-theme" />
            <AuthorizeView>
                <Authorized>
                    @if (_user?.IsOffice == true)
                    {
                        <NavLink class="topbar-link" href="my-requisitions" title="My requisitions">
                            <i class="bi bi-receipt" aria-hidden="true"></i>
                            <span class="d-none d-xl-inline">My requests</span>
                        </NavLink>
                        <NavLink class="topbar-link topbar-link-appcse" href="my-app-cse" title="My office's APP-CSE">
                            <i class="bi bi-clipboard-data" aria-hidden="true"></i>
                            <span class="d-none d-xl-inline">My APP-CSE</span>
                        </NavLink>
                        <NavLink class="topbar-link" href="cart" aria-label="@($"Cart, {Cart.Count} items")" title="Cart">
                            <i class="bi bi-cart3" aria-hidden="true"></i>
                            @if (Cart.Count > 0)
                            {
                                <span class="cart-count">@Cart.Count</span>
                            }
                        </NavLink>
                    }
                    <NavLink class="topbar-link topbar-user" href="change-password" title="Change password">
                        <i class="bi bi-person-circle" aria-hidden="true"></i>
                        <span class="d-none d-lg-inline">@context.User.Identity?.Name</span>
                    </NavLink>
                    <form autocomplete="off" method="post" action="/account/logout" class="m-0" @ref="_logoutForm">
                        <AntiforgeryToken />
                        <button type="button" class="btn btn-sm topbar-btn" @onclick="ConfirmLogoutAsync" aria-label="Log out" title="Log out"><i class="bi bi-box-arrow-right d-md-none" aria-hidden="true"></i><span class="logout-text">Log out</span></button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <button type="button" class="btn btn-sm topbar-btn-solid" @onclick="() => Flow.ShowLoginAsync()">
                        Log in
                    </button>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</header>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private CurrentUser? _user;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) _user = CurrentUser.From((await AuthState).User);
        Cart.Changed += OnCartChanged;
        Nav.LocationChanged += OnLocationChanged;
        await Cart.RefreshAsync();
    }

    // Gold dot on "What's new" until this browser has opened the page for the newest version.
    private bool _isNew;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _isNew = await JS.InvokeAsync<bool>("amsWhatsNew.isNew", AMS_Shopee.Services.Ui.Changelog.LatestVersion)
                     && !Nav.Uri.Contains("/whats-new", StringComparison.OrdinalIgnoreCase);
            if (_isNew) StateHasChanged();
        }
        catch { /* prerendering or closed */ }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_isNew && e.Location.Contains("/whats-new", StringComparison.OrdinalIgnoreCase))
        {
            _isNew = false;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private ElementReference _logoutForm;

    private async Task ConfirmLogoutAsync()
    {
        var message = _user?.IsOffice == true
            ? "You'll need to log in again to request supplies. Items in your cart stay saved."
            : "You'll need to log in again to continue.";
        if (await Modal.ConfirmAsync("Log out?", message, "Log out", "Stay logged in", ModalVariant.Warning))
            await JS.InvokeVoidAsync("ams.submitForm", _logoutForm);
    }

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
