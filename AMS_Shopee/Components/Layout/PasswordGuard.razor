@* Keeps an office on the Change password page until it replaces the temporary
   password AMS gave it. Placed once in MainLayout. *@
@implements IDisposable
@inject NavigationManager Nav

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private bool _mustChange;

    protected override async Task OnInitializedAsync()
    {
        _mustChange = AuthState is not null && (await AuthState).User.FindFirst("must_change_password")?.Value == "1";
        Nav.LocationChanged += OnLocationChanged;
        Enforce();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Enforce();

    private void Enforce()
    {
        if (!_mustChange) return;
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        if (!path.Equals("/change-password", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/change-password", replace: true);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
