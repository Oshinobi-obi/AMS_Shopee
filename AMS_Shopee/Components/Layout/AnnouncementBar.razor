@* Notices from AMS (posted in StockWatch → Announcements), shown under the top bar.
   Closing one hides it on this computer only; a new or edited notice shows again. *@
@inject LiveRefresh Live
@implements IDisposable
@inject AnnouncementService Announcements
@inject IJSRuntime JS

@if (Visible.Count > 0)
{
    <div class="ann-bar-stack" role="region" aria-label="Announcements from AMS">
        @foreach (var a in Visible)
        {
            <div class="@($"ann-bar ann-{a.Level}")" @key="a.Id">
                <div class="container-xl ann-bar-inner">
                    <i class="bi @Icon(a.Level)" aria-hidden="true"></i>
                    <div class="ann-bar-text">
                        <strong>@a.Title</strong>
                        <span>@a.Message</span>
                    </div>
                    <button type="button" class="ann-close" aria-label="@($"Close the announcement {a.Title}")" @onclick="() => DismissAsync(a)">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    private const string Sound = "sounds/Shopee_Announcement.mp3";
    private List<LiveAnnouncement> _items = [];
    private HashSet<string> _dismissed = [];
    private readonly HashSet<string> _known = [];   // announcements this screen has already shown
    private bool _ready;

    private List<LiveAnnouncement> Visible => _ready ? _items.Where(a => !_dismissed.Contains(Key(a))).ToList() : [];

    // An edited notice gets a new key, so it shows again even if an older version was closed.
    // (A fixed FNV-1a hash: string.GetHashCode() changes every time the site restarts.)
    private static string Key(LiveAnnouncement a)
    {
        uint h = 2166136261;
        foreach (var c in a.Title + "\n" + a.Message) { h ^= c; h *= 16777619; }
        return $"{a.Id}:{h:x8}";
    }

    private static string Icon(string level) => level switch
    {
        "urgent" => "bi-exclamation-octagon-fill",
        "warning" => "bi-exclamation-triangle-fill",
        _ => "bi-megaphone-fill",
    };

    protected override async Task OnInitializedAsync() => _items = await Announcements.LiveAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _dismissed = (await JS.InvokeAsync<string[]>("amsUi.dismissedAnnouncements")).ToHashSet();
            await JS.InvokeVoidAsync("amsLive.preload", (object)new[] { Sound });
        }
        catch (JSDisconnectedException) { }
        // What is already showing when the page opens stays silent.
        foreach (var a in _items) _known.Add(Key(a));
        _ready = true;
        StateHasChanged();
        _ = KeepFreshAsync(_cts.Token);
    }

    // Shows the latest announcements; plays the sound once for each one this screen hasn't
    // shown before (a new notice, or an edited one), unless the office closed it earlier.
    private async Task ApplyAsync(List<LiveAnnouncement> items)
    {
        _items = items;
        var fresh = items.Where(a => !_known.Contains(Key(a)) && !_dismissed.Contains(Key(a))).ToList();
        foreach (var a in items) _known.Add(Key(a));
        StateHasChanged();
        if (!_ready || fresh.Count == 0) return;

        var top = fresh[0];   // most important first (urgent, then important, then information)
        try
        {
            await JS.InvokeVoidAsync("amsLive.notify",
                fresh.Count == 1 ? $"Announcement: {top.Title}" : $"{fresh.Count} new announcements",
                top.Message, Sound, "/");
        }
        catch (JSDisconnectedException) { }
    }

    // Safety net: re-check every 30 seconds on its own, even if the live watcher ever stops.
    private readonly CancellationTokenSource _cts = new();

    private async Task KeepFreshAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                var items = await Announcements.LiveAsync(ct);
                await InvokeAsync(() => ApplyAsync(items));
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    private async Task DismissAsync(LiveAnnouncement a)
    {
        _dismissed.Add(Key(a));
        try { await JS.InvokeVoidAsync("amsUi.dismissAnnouncement", Key(a)); } catch (JSDisconnectedException) { }
    }

    // Live: when announcements change on either website, reload without a refresh.
    private static readonly string[] LiveAreas = ["announcements"];
    protected override void OnInitialized() => Live.AreasChanged += OnAreasAsync;

    private async Task OnAreasAsync(IReadOnlySet<string> areas)
    {
        if (!areas.Overlaps(LiveAreas)) return;
        await ApplyAsync(await Announcements.LiveAsync());
    }

    public void Dispose()
    {
        Live.AreasChanged -= OnAreasAsync;
        _cts.Cancel();
        _cts.Dispose();
    }
}
