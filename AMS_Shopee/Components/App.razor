<!DOCTYPE html>
<html lang="en" data-season="@_season">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["js/theme-init.js"]"></script>
    <meta name="theme-color" content="#00007f" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" href="images/apple-touch-icon.png" />
    @* These are Bootstrap and Bootstrap Icons, which the modals use. I keep a copy in wwwroot/lib
       so the site still works even without internet. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["css/ris.css"]" />
    <link rel="stylesheet" href="@Assets["css/motion.css"]" />
    <link rel="stylesheet" href="@Assets["css/accountability.css"]" />
    <link rel="stylesheet" href="@Assets["css/season.css"]" />
    <link rel="stylesheet" href="@Assets["AMS_Shopee.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["js/app.js"]"></script>
    <script src="@Assets["js/live.js"]"></script>
    <script src="@Assets["js/ui.js"]"></script>
    <script src="@Assets["js/motion.js"]"></script>
    <script src="@Assets["js/season.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@inject AMS_Shopee.Services.Ui.SeasonState Season
@code {
    private string _season = "";   // seasonal theme for the headers ("" means none), set in e-PINS
    protected override async Task OnInitializedAsync() => _season = await Season.CurrentAsync();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // All pages are interactive except the ones marked [ExcludeFromInteractiveRouting], like the Error page.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
