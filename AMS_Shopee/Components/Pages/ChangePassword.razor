@page "/change-password"
@inject IDbContextFactory<AmsDbContext> DbFactory
@inject NavigationManager Nav
@inject AddToCartFlow Flow

<PageTitle>Change password | AMS</PageTitle>

<section class="page-head">
    <div class="container-xl">
        <h1>Change password</h1>
        <p>@(_mustChange ? "You're using a temporary password from AMS. Choose your office's own password to continue." : "Choose a new password for your office account.")</p>
    </div>
</section>

<div class="container-xl page-body">
    @if (_userId is null)
    {
        <div class="empty-state">
            <i class="bi bi-person-lock" aria-hidden="true"></i>
            <h2>Log in first</h2>
            <p>Log in with your office account to change its password.</p>
            <button type="button" class="btn btn-primary" @onclick="() => Flow.ShowLoginAsync()">Log in</button>
        </div>
    }
    else
    {
        <section class="panel mx-auto" style="max-width: 520px">
            <div class="panel-body">
                <div class="mb-3">
                    <label class="form-label" for="cp-current">Current password</label>
                    <input id="cp-current" class="form-control" type="@(_show ? "text" : "password")" autocomplete="off" @bind="_current" />
                    @if (_mustChange)
                    {
                        <div class="form-text">This is the temporary password AMS gave you.</div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label" for="cp-new">New password</label>
                    <input id="cp-new" class="form-control" type="@(_show ? "text" : "password")" autocomplete="off" @bind="_new" @bind:event="oninput" />
                    <div class="form-text @(_new.Length > 0 && !StrongEnough(_new) ? "text-danger" : "")">At least 8 characters, with letters and numbers.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="cp-confirm">Type the new password again</label>
                    <input id="cp-confirm" class="form-control" type="@(_show ? "text" : "password")" autocomplete="off" @bind="_confirm" @bind:event="oninput" />
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="cp-show" @bind="_show" />
                    <label class="form-check-label" for="cp-show">Show passwords</label>
                </div>

                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_error</div>
                }

                <button type="button" class="btn btn-primary btn-lg w-100" @onclick="SaveAsync" disabled="@_saving">
                    @if (_saving) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                    Change password
                </button>
                <p class="small text-secondary mt-3 mb-0">Everyone in your office who uses this account will need the new password. Forgot it? Ask AMS to reset it.</p>
            </div>
        </section>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private uint? _userId;
    private bool _mustChange, _show, _saving;
    private string _current = "", _new = "", _confirm = "";
    private string? _error;

    private static bool StrongEnough(string p) => p.Length >= 8 && p.Any(char.IsLetter) && p.Any(char.IsDigit);

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        _userId = uint.TryParse(user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
        _mustChange = user?.FindFirst("must_change_password")?.Value == "1";
    }

    private async Task SaveAsync()
    {
        _error = string.IsNullOrEmpty(_current) ? "Enter your current password."
               : !StrongEnough(_new) ? "The new password needs at least 8 characters, with letters and numbers."
               : _new != _confirm ? "The two new passwords don't match."
               : _new == _current ? "Choose a password different from the current one."
               : null;
        if (_error is not null || _userId is null) return;

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var u = await db.Users.FindAsync(_userId.Value);
            if (u is null) { _error = "Your account wasn't found. Log in again."; return; }

            bool ok;
            try { ok = BCrypt.Net.BCrypt.Verify(_current, u.PasswordHash); } catch { ok = false; }
            if (!ok) { _error = "Your current password is incorrect."; return; }

            u.PasswordHash = BCrypt.Net.BCrypt.HashPassword(_new, 12);
            u.RequirePasswordChange = false;
            db.UserActivities.Add(new UserActivity { UserId = u.UserId, ActivityType = "PASSWORD_CHANGED", Description = "Changed own password" });
            await db.SaveChangesAsync();

            // New sign-in cookie without the "must change" flag, then back to the catalog.
            Nav.NavigateTo("/account/refresh?returnUrl=%2F%3Fpassword%3Dchanged", forceLoad: true);
        }
        catch (Exception)
        {
            _error = "The password couldn't be changed. Check your connection and try again.";
        }
        finally { _saving = false; }
    }
}
